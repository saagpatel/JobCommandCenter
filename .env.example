# Environment variables
# Copy to .env and fill in values before running
#
# Vite exposes variables prefixed with VITE_ to the frontend via import.meta.env
# See: https://vitejs.dev/guide/env-and-mode

# Application mode (development | production | test)
# NODE_ENV=development

# Vite dev server port (optional, defaults to 5173)
# VITE_PORT=5173
